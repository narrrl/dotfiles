[global]
corner_radius = 0
transparency = 90
frame_color = "#545c52"
frame_width = 1
separator_color= frame
highlight = "#eef1ea"

[urgency_low]
background = "#0f110e"
foreground = "#ccd2cb"
timeout = 4

[urgency_normal]
background = "#0f110e"
foreground = "#ccd2cb"
timeout = 6

[urgency_critical]
background = "#0f110e"
foreground = "#ccd2cb"
frame_color = "#c8684f"
