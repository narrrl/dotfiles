[global]
corner_radius = 4
transparency = 90
frame_color = "#94e2d5"
frame_width = 1
separator_color= frame
highlight = "#89b4fa"

[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"
timeout = 4

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"
timeout = 6

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#f38ba8"
